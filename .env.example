# Copy to .env.local and fill in from Supabase → Project Settings → API

# Public (safe in the browser). With these two set, orders + waiter calls sync across devices
# (run supabase/quick-sync.sql once first). Without them, data stays in each browser only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Final production domain — printed QR codes point here. Set it to the PRODUCTION domain
# (e.g. https://scan2serve.vercel.app), never a per-deploy preview URL, before printing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never expose to the browser (used later for staff invites)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner / Staff demo login (stored in the browser's localStorage — demo only, not secure)
# Defaults: owner = admin123, staff = staff123
NEXT_PUBLIC_DEMO_OWNER_PASSWORD=admin123
NEXT_PUBLIC_DEMO_STAFF_PASSWORD=staff123
